# Email Configuration
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=your_contact_email@example.com

# Google Sheets Integration (choose one method)
# Method 1: Webhook URL (recommended for simplicity)
GOOGLE_SHEETS_WEBHOOK_URL=https://your-webhook-url.com

# Method 2: Google Service Account (for direct API access)
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_NAME=Waitlist
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Alternative: JSON format for service account
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"..."}